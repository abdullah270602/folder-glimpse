<Window x:Class="FolderPeek.Settings.SettingsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="FolderPeek Settings" Width="560" Height="720" MinWidth="520" MinHeight="620"
        ShowInTaskbar="False" WindowStartupLocation="CenterScreen" Background="{DynamicResource PanelBrush}">
  <Window.Resources>
    <SolidColorBrush x:Key="PanelBrush" Color="#F7F7F7"/><SolidColorBrush x:Key="TextBrush" Color="#171717"/>
    <SolidColorBrush x:Key="SubtleTextBrush" Color="#666666"/><SolidColorBrush x:Key="LineBrush" Color="#18000000"/>
    <SolidColorBrush x:Key="ControlBrush" Color="White"/>
    <SolidColorBrush x:Key="{x:Static SystemColors.ControlTextBrushKey}" Color="#171717"/>
    <Style TargetType="TextBlock"><Setter Property="Foreground" Value="{DynamicResource TextBrush}"/></Style>
    <Style TargetType="CheckBox"><Setter Property="Foreground" Value="{DynamicResource TextBrush}"/><Setter Property="Margin" Value="0,6"/></Style>
    <Style TargetType="ComboBox"><Setter Property="MinWidth" Value="170"/><Setter Property="Padding" Value="7,4"/><Setter Property="IsEditable" Value="True"/><Setter Property="IsReadOnly" Value="True"/><Setter Property="Foreground" Value="#171717"/><Setter Property="TextElement.Foreground" Value="#171717"/><Setter Property="Background" Value="White"/></Style>
    <Style TargetType="ComboBoxItem"><Setter Property="Foreground" Value="#171717"/><Setter Property="Background" Value="White"/></Style>
  </Window.Resources>
  <Grid Margin="28,22">
    <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
    <StackPanel><TextBlock Text="FolderPeek" FontSize="24" FontWeight="SemiBold"/><TextBlock Text="Preview folders your way" Foreground="{DynamicResource SubtleTextBrush}" Margin="0,3,0,18"/></StackPanel>
    <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
      <StackPanel Margin="0,0,12,0">
        <TextBlock Text="APPEARANCE" FontSize="11" FontWeight="SemiBold" Foreground="{DynamicResource SubtleTextBrush}"/>
        <Grid Margin="0,10,0,8"><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><TextBlock Text="Theme" VerticalAlignment="Center"/><ComboBox x:Name="ThemeBox" Grid.Column="1" SelectionChanged="SettingChanged"/></Grid>
        <TextBlock x:Name="WidthLabel"/><Slider x:Name="WidthSlider" Minimum="300" Maximum="700" TickFrequency="10" IsSnapToTickEnabled="True" ValueChanged="SettingChanged"/>
        <TextBlock x:Name="HeightLabel" Margin="0,10,0,0"/><Slider x:Name="HeightSlider" Minimum="250" Maximum="900" TickFrequency="10" IsSnapToTickEnabled="True" ValueChanged="SettingChanged"/>
        <Grid Margin="0,10,0,8"><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><TextBlock Text="Display density" VerticalAlignment="Center"/><ComboBox x:Name="DensityBox" Grid.Column="1" SelectionChanged="SettingChanged"/></Grid>
        <CheckBox x:Name="PathCheck" Content="Show full folder path" Checked="SettingChanged" Unchecked="SettingChanged"/>
        <CheckBox x:Name="SizeCheck" Content="Show file sizes" Checked="SettingChanged" Unchecked="SettingChanged"/>
        <CheckBox x:Name="DateCheck" Content="Show modified dates" Checked="SettingChanged" Unchecked="SettingChanged"/>

        <Separator Margin="0,15"/><TextBlock Text="CONTENTS" FontSize="11" FontWeight="SemiBold" Foreground="{DynamicResource SubtleTextBrush}"/>
        <CheckBox x:Name="HiddenCheck" Content="Show hidden files" Checked="SettingChanged" Unchecked="SettingChanged"/>
        <CheckBox x:Name="FoldersCheck" Content="Folders first" Checked="SettingChanged" Unchecked="SettingChanged"/>
        <Grid Margin="0,6"><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><TextBlock Text="Sort by" VerticalAlignment="Center"/><ComboBox x:Name="SortBox" Grid.Column="1" SelectionChanged="SettingChanged"/></Grid>
        <Grid Margin="0,6"><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><TextBlock Text="Initial item limit" VerticalAlignment="Center"/><ComboBox x:Name="LimitBox" Grid.Column="1" SelectionChanged="SettingChanged"/></Grid>

        <Separator Margin="0,15"/><TextBlock Text="INPUT &amp; WINDOWS" FontSize="11" FontWeight="SemiBold" Foreground="{DynamicResource SubtleTextBrush}"/>
        <Grid Margin="0,10,0,6"><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><TextBlock Text="Preview hotkey" VerticalAlignment="Center"/><ComboBox x:Name="HotkeyBox" Grid.Column="1" SelectionChanged="SettingChanged"/></Grid>
        <Grid Margin="0,6"><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><TextBlock Text="Tap behavior" VerticalAlignment="Center"/><ComboBox x:Name="TapBox" Grid.Column="1" SelectionChanged="SettingChanged"/></Grid>
        <TextBlock x:Name="HoldLabel" Margin="0,10,0,0"/><Slider x:Name="HoldSlider" Minimum="100" Maximum="600" TickFrequency="25" IsSnapToTickEnabled="True" ValueChanged="SettingChanged"/>
        <CheckBox x:Name="StartupCheck" Content="Launch FolderPeek when I sign in" Checked="StartupChanged" Unchecked="StartupChanged"/>
      </StackPanel>
    </ScrollViewer>
    <Grid Grid.Row="2" Margin="0,16,0,0"><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
      <TextBlock x:Name="ErrorText" Foreground="#D13438" VerticalAlignment="Center" TextWrapping="Wrap"/>
      <StackPanel Grid.Column="1" Orientation="Horizontal"><Button Content="Reset defaults" Padding="15,7" Margin="8,0" Click="ResetClicked"/><Button Content="Done" IsDefault="True" Padding="22,7" Click="DoneClicked"/></StackPanel>
    </Grid>
  </Grid>
</Window>
