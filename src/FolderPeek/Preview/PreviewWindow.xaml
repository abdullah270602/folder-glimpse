<Window x:Class="FolderPeek.Preview.PreviewWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="FolderPeek" Width="430" Height="200" MinHeight="150" MaxHeight="620"
        WindowStyle="None" ResizeMode="NoResize" ShowInTaskbar="False"
        ShowActivated="False" Topmost="True" Background="#F7F7F7"
        SnapsToDevicePixels="True" UseLayoutRounding="True">
  <Window.Resources>
    <SolidColorBrush x:Key="PanelBrush" Color="#F7F7F7" />
    <SolidColorBrush x:Key="TextBrush" Color="#171717" />
    <SolidColorBrush x:Key="SubtleTextBrush" Color="#666666" />
    <SolidColorBrush x:Key="LineBrush" Color="#18000000" />
    <SolidColorBrush x:Key="ScrollTrackBrush" Color="#0D000000" />
    <SolidColorBrush x:Key="ScrollThumbBrush" Color="#59000000" />
    <SolidColorBrush x:Key="ScrollThumbHoverBrush" Color="#80000000" />
    <Style TargetType="TextBlock"><Setter Property="Foreground" Value="{DynamicResource TextBrush}" /></Style>
  </Window.Resources>
  <Border x:Name="RootBorder" Background="{DynamicResource PanelBrush}" BorderBrush="{DynamicResource LineBrush}"
          BorderThickness="1" CornerRadius="10">
    <Grid>
      <Grid.RowDefinitions>
        <RowDefinition Height="Auto" />
        <RowDefinition Height="1" />
        <RowDefinition Height="*" />
        <RowDefinition Height="1" />
        <RowDefinition Height="Auto" />
      </Grid.RowDefinitions>
      <Grid Grid.Row="0" Margin="18,15,18,13">
        <Grid.ColumnDefinitions><ColumnDefinition Width="34" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
        <TextBlock Text="📁" FontSize="22" VerticalAlignment="Center" />
        <StackPanel Grid.Column="1">
          <TextBlock Text="{Binding FolderName}" FontSize="15" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" />
          <TextBlock Text="{Binding FolderPath}" ToolTip="{Binding FolderPath}" Visibility="{Binding PathVisibility}"
                     FontSize="11" Foreground="{DynamicResource SubtleTextBrush}" Margin="0,2,0,0" TextTrimming="CharacterEllipsis" />
        </StackPanel>
      </Grid>
      <Border Grid.Row="1" Background="{DynamicResource LineBrush}" />
      <Grid Grid.Row="2">
        <ListBox x:Name="EntryList" ItemsSource="{Binding Entries}" Background="Transparent" BorderThickness="0" Padding="8,7"
                 ScrollViewer.HorizontalScrollBarVisibility="Disabled" ScrollViewer.VerticalScrollBarVisibility="Auto"
                 ScrollViewer.CanContentScroll="True" VirtualizingPanel.IsVirtualizing="True" VirtualizingPanel.VirtualizationMode="Recycling">
          <ListBox.Resources>
            <Style TargetType="ScrollBar">
              <Setter Property="Width" Value="12" />
              <Setter Property="Background" Value="Transparent" />
              <Setter Property="Template">
                <Setter.Value>
                  <ControlTemplate TargetType="ScrollBar">
                    <Grid Width="12" Background="Transparent">
                      <Border Width="4" Margin="0,4" HorizontalAlignment="Center"
                              Background="{DynamicResource ScrollTrackBrush}" CornerRadius="2" />
                      <Track x:Name="PART_Track" Margin="0,4" IsDirectionReversed="True">
                        <Track.DecreaseRepeatButton>
                          <RepeatButton Command="ScrollBar.PageUpCommand" Focusable="False" Opacity="0"
                                        CommandTarget="{Binding RelativeSource={RelativeSource TemplatedParent}}" />
                        </Track.DecreaseRepeatButton>
                        <Track.Thumb>
                          <Thumb MinHeight="34" Focusable="False">
                            <Thumb.Template>
                              <ControlTemplate TargetType="Thumb">
                                <Border x:Name="ThumbBody" Width="6" HorizontalAlignment="Center"
                                        Background="{DynamicResource ScrollThumbBrush}" CornerRadius="3" />
                                <ControlTemplate.Triggers>
                                  <Trigger Property="IsMouseOver" Value="True">
                                    <Setter TargetName="ThumbBody" Property="Background" Value="{DynamicResource ScrollThumbHoverBrush}" />
                                  </Trigger>
                                  <Trigger Property="IsDragging" Value="True">
                                    <Setter TargetName="ThumbBody" Property="Background" Value="{DynamicResource TextBrush}" />
                                  </Trigger>
                                </ControlTemplate.Triggers>
                              </ControlTemplate>
                            </Thumb.Template>
                          </Thumb>
                        </Track.Thumb>
                        <Track.IncreaseRepeatButton>
                          <RepeatButton Command="ScrollBar.PageDownCommand" Focusable="False" Opacity="0"
                                        CommandTarget="{Binding RelativeSource={RelativeSource TemplatedParent}}" />
                        </Track.IncreaseRepeatButton>
                      </Track>
                    </Grid>
                  </ControlTemplate>
                </Setter.Value>
              </Setter>
            </Style>
          </ListBox.Resources>
          <ListBox.ItemContainerStyle>
            <Style TargetType="ListBoxItem">
              <Setter Property="Focusable" Value="False" /><Setter Property="IsHitTestVisible" Value="False" />
              <Setter Property="Height" Value="{Binding Tag, RelativeSource={RelativeSource AncestorType=ListBox}}" />
              <Setter Property="Padding" Value="9,0" /><Setter Property="HorizontalContentAlignment" Value="Stretch" />
              <Setter Property="Template">
                <Setter.Value><ControlTemplate TargetType="ListBoxItem"><Border Padding="{TemplateBinding Padding}" CornerRadius="5"><ContentPresenter /></Border></ControlTemplate></Setter.Value>
              </Setter>
            </Style>
          </ListBox.ItemContainerStyle>
          <ListBox.ItemTemplate>
            <DataTemplate>
              <Grid>
                <Grid.ColumnDefinitions><ColumnDefinition Width="28" /><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                <Image Source="{Binding Icon}" Width="18" Height="18" VerticalAlignment="Center" />
                <TextBlock Grid.Column="1" Text="{Binding Name}" ToolTip="{Binding Name}" FontSize="13" VerticalAlignment="Center"
                           Foreground="{DynamicResource TextBrush}" TextTrimming="CharacterEllipsis" />
                <TextBlock Grid.Column="2" Text="{Binding SizeText}" Visibility="{Binding SizeVisibility}" FontSize="11" Margin="12,0,3,0" VerticalAlignment="Center"
                           Foreground="{DynamicResource SubtleTextBrush}" />
                <TextBlock Grid.Column="3" Text="{Binding ModifiedText}" Visibility="{Binding ModifiedVisibility}" FontSize="11" Margin="12,0,3,0" VerticalAlignment="Center"
                           Foreground="{DynamicResource SubtleTextBrush}" />
              </Grid>
            </DataTemplate>
          </ListBox.ItemTemplate>
        </ListBox>
        <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center" Visibility="{Binding EmptyVisibility}">
          <TextBlock Text="This folder is empty" FontSize="13" Foreground="{DynamicResource SubtleTextBrush}" />
        </StackPanel>
        <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center" Visibility="{Binding LoadingVisibility}">
          <ProgressBar IsIndeterminate="True" Width="110" Height="3" />
          <TextBlock Text="Loading…" FontSize="12" Margin="0,10,0,0" HorizontalAlignment="Center" Foreground="{DynamicResource SubtleTextBrush}" />
        </StackPanel>
      </Grid>
      <Border Grid.Row="3" Background="{DynamicResource LineBrush}" />
      <TextBlock Grid.Row="4" Text="{Binding Status}" FontSize="11" Margin="18,10"
                 Foreground="{DynamicResource SubtleTextBrush}" />
    </Grid>
  </Border>
</Window>
