<UserControl x:Class="FolderGlimpse.Branding.AboutView"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:branding="clr-namespace:FolderGlimpse.Branding"
        Background="{DynamicResource WindowBrush}" UseLayoutRounding="True" SnapsToDevicePixels="True">
  <Grid Margin="30,26,30,22">
    <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="1" /><RowDefinition Height="*" /></Grid.RowDefinitions>
    <Grid Margin="0,0,0,22">
      <Grid.ColumnDefinitions><ColumnDefinition Width="60" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
      <branding:BrandMark Width="48" Height="48" VerticalAlignment="Center" />
      <StackPanel Grid.Column="1" VerticalAlignment="Center">
        <TextBlock FontFamily="Segoe UI Variable Text, Segoe UI" FontSize="26" FontWeight="SemiBold">
          <Run Text="Folder" /><Run Text="Glimpse" Foreground="{DynamicResource BrandBlueBrush}" />
        </TextBlock>
        <TextBlock Text="Glance inside folders without opening them, and so much more."
                   Margin="0,3,0,0" FontSize="12" TextWrapping="Wrap" Foreground="{DynamicResource SubtleTextBrush}" />
      </StackPanel>
    </Grid>
    <Border Grid.Row="1" Background="{DynamicResource LineBrush}" />
    <StackPanel Grid.Row="2" Margin="0,20,0,12">
      <TextBlock Text="FolderGlimpse is a lightweight Windows utility for quickly inspecting folder contents from File Explorer."
                 FontSize="13" LineHeight="20" TextWrapping="Wrap" />
      <TextBlock x:Name="VersionText" Margin="0,18,0,0" FontSize="12" Foreground="{DynamicResource SubtleTextBrush}" />
      <StackPanel Orientation="Horizontal" Margin="0,18,0,0">
        <Button x:Name="CheckUpdatesButton" Content="Check for updates" AutomationProperties.Name="Check GitHub Releases for updates" Click="CheckForUpdates" />
        <Button Content="Copy diagnostics" Margin="10,0,0,0" AutomationProperties.Name="Copy privacy-safe diagnostics" Click="CopyDiagnostics" />
        <Button x:Name="ViewReleaseButton" Content="View release" Margin="10,0,0,0"
                Visibility="Collapsed" AutomationProperties.Name="Open the new release on GitHub"
                Style="{StaticResource PrimaryButtonStyle}" Click="ViewRelease" />
      </StackPanel>
      <TextBlock x:Name="UpdateStatusText" Margin="0,10,0,0" FontSize="12"
                 Foreground="{DynamicResource SubtleTextBrush}" TextWrapping="Wrap" />
    </StackPanel>
  </Grid>
</UserControl>
