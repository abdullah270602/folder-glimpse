<UserControl x:Class="FolderGlimpse.Shell.HowToUseView" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
  <UserControl.Resources>
    <Style x:Key="KeycapStyle" TargetType="Border">
      <Setter Property="Background" Value="{DynamicResource ControlBrush}"/>
      <Setter Property="BorderBrush" Value="{DynamicResource LineBrush}"/>
      <Setter Property="BorderThickness" Value="1"/>
      <Setter Property="CornerRadius" Value="4"/>
      <Setter Property="Padding" Value="9,4"/>
    </Style>
  </UserControl.Resources>

  <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
    <StackPanel Margin="34,28,34,30">
      <TextBlock Text="How to Use" FontSize="28" FontWeight="SemiBold"/>
      <TextBlock Text="Choose the way you want to glimpse folders in File Explorer." Margin="0,4,0,24" Foreground="{DynamicResource SubtleTextBrush}"/>

      <StackPanel Margin="0,0,0,24">
        <TextBlock Text="Hover to glimpse" Style="{StaticResource SectionTitleStyle}"/>
        <Border Style="{StaticResource SettingsCardStyle}" Margin="0" Padding="18,15">
          <StackPanel>
            <TextBlock Text="Any-folder hover is ready by default. Rest the pointer over a folder in File Explorer." TextWrapping="Wrap"/>
            <TextBlock Text="Its glimpse appears after the configured delay without changing your selection." Margin="0,9,0,0" TextWrapping="Wrap"/>
            <TextBlock Text="Move away to close it. Hover glimpses keep File Explorer in control." Margin="0,9,0,0" Foreground="{DynamicResource SubtleTextBrush}" TextWrapping="Wrap"/>
          </StackPanel>
        </Border>
      </StackPanel>

      <StackPanel Margin="0,0,0,24">
        <TextBlock Text="Adjust hover" Style="{StaticResource SectionTitleStyle}"/>
        <Border Style="{StaticResource SettingsCardStyle}" Margin="0" Padding="18,15">
          <StackPanel>
            <TextBlock Text="Any folder previews whichever folder is under the pointer." TextWrapping="Wrap"/>
            <TextBlock Text="Selected folder limits hover to the folder already selected in Explorer." Margin="0,9,0,0" TextWrapping="Wrap"/>
            <TextBlock Text="In Settings, switch hover off, require Ctrl or Shift, or tune the open delay, exit delay, and movement tolerance." Margin="0,9,0,0" Foreground="{DynamicResource SubtleTextBrush}" TextWrapping="Wrap"/>
          </StackPanel>
        </Border>
      </StackPanel>

      <StackPanel Margin="0,0,0,24">
        <TextBlock Text="Keyboard alternative" Style="{StaticResource SectionTitleStyle}"/>
        <Border Style="{StaticResource SettingsCardStyle}" Margin="0" Padding="18,15">
          <StackPanel>
            <TextBlock Text="Select one folder in File Explorer."/>
            <StackPanel Orientation="Horizontal" Margin="0,10,0,0">
              <TextBlock Text="With tap-to-toggle, tap" VerticalAlignment="Center" Margin="0,0,8,0"/>
              <Border Style="{StaticResource KeycapStyle}"><TextBlock Text="{Binding ShortcutText, Mode=OneWay}" FontWeight="SemiBold"/></Border>
              <TextBlock Text=" to keep a glimpse open." VerticalAlignment="Center"/>
            </StackPanel>
            <StackPanel Orientation="Horizontal" Margin="0,10,0,0">
              <TextBlock Text="Hold" VerticalAlignment="Center" Margin="0,0,8,0"/>
              <Border Style="{StaticResource KeycapStyle}"><TextBlock Text="{Binding ShortcutText, Mode=OneWay}" FontWeight="SemiBold"/></Border>
              <TextBlock Text=" for a momentary glimpse." VerticalAlignment="Center"/>
            </StackPanel>
            <TextBlock Text="Choose Space or Ctrl + Space and change tap behavior in Settings. Press Esc to close a sticky glimpse." Margin="0,10,0,0" Foreground="{DynamicResource SubtleTextBrush}" TextWrapping="Wrap"/>
          </StackPanel>
        </Border>
      </StackPanel>

      <StackPanel Margin="0,0,0,24">
        <TextBlock Text="Optional mouse shortcuts" Style="{StaticResource SectionTitleStyle}"/>
        <Border Style="{StaticResource SettingsCardStyle}" Margin="0" Padding="18,15">
          <StackPanel>
            <TextBlock Text="Enable middle-click, Ctrl + left-click, or Ctrl + right-click in Settings to open a sticky glimpse directly." TextWrapping="Wrap"/>
            <TextBlock Text="They are off by default and only take effect over a verified local folder in File Explorer. Normal and uncertain clicks continue to Windows." Margin="0,9,0,0" Foreground="{DynamicResource SubtleTextBrush}" TextWrapping="Wrap"/>
          </StackPanel>
        </Border>
      </StackPanel>

      <StackPanel Margin="0,0,0,24">
        <TextBlock Text="Open items" Style="{StaticResource SectionTitleStyle}"/>
        <Border Style="{StaticResource SettingsCardStyle}" Margin="0" Padding="18,15">
          <StackPanel>
            <TextBlock Text="Click an item once to pin the hover glimpse and make it interactive." TextWrapping="Wrap"/>
            <TextBlock Text="Double-click a file to use its normal Windows app, or double-click a folder to open it in File Explorer." Margin="0,9,0,0" TextWrapping="Wrap"/>
            <TextBlock Text="A pinned or keyboard-triggered glimpse supports selection, context actions, and Enter to open." Margin="0,9,0,0" Foreground="{DynamicResource SubtleTextBrush}" TextWrapping="Wrap"/>
          </StackPanel>
        </Border>
      </StackPanel>

      <StackPanel>
        <TextBlock Text="Select more than one item" Style="{StaticResource SectionTitleStyle}"/>
        <Border Style="{StaticResource SettingsCardStyle}" Margin="0" Padding="18,15">
          <StackPanel>
            <StackPanel Orientation="Horizontal">
              <Border Style="{StaticResource KeycapStyle}"><TextBlock Text="CTRL" FontWeight="SemiBold"/></Border>
              <TextBlock Text=" + click to select individual items" VerticalAlignment="Center"/>
            </StackPanel>
            <StackPanel Orientation="Horizontal" Margin="0,10,0,0">
              <Border Style="{StaticResource KeycapStyle}"><TextBlock Text="SHIFT" FontWeight="SemiBold"/></Border>
              <TextBlock Text=" + click to select a range" VerticalAlignment="Center"/>
            </StackPanel>
          </StackPanel>
        </Border>
      </StackPanel>
    </StackPanel>
  </ScrollViewer>
</UserControl>
