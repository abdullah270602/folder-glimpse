<UserControl x:Class="FolderGlimpse.Shell.WelcomeView" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:branding="clr-namespace:FolderGlimpse.Branding">
  <Grid Background="{DynamicResource WindowBrush}">
    <Border Width="560" Padding="42,34" HorizontalAlignment="Center" VerticalAlignment="Center" Style="{StaticResource SettingsCardStyle}">
      <StackPanel>
        <branding:BrandMark Width="66" Height="66" HorizontalAlignment="Center"/>
        <TextBlock HorizontalAlignment="Center" Margin="0,17,0,0" FontSize="28" FontWeight="SemiBold"><Run Text="Folder"/><Run Text="Glimpse" Foreground="{DynamicResource BrandBlueBrush}"/></TextBlock>
        <TextBlock Text="Glance inside folders without opening them, and so much more." HorizontalAlignment="Center" Margin="0,6,0,0" Foreground="{DynamicResource SubtleTextBrush}" TextWrapping="Wrap"/>
        <TextBlock Text="See inside folders instantly" Margin="0,26,0,12" FontSize="17" FontWeight="SemiBold"/>
        <TextBlock Text="1   Open File Explorer"/><TextBlock Text="2   Select any folder" Margin="0,9,0,0"/><TextBlock Margin="0,9,0,0"><Run Text="3   Press "/><Run Text="{Binding ShortcutText, Mode=OneWay}"/></TextBlock>
        <Grid Margin="0,22,0,0"><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions><StackPanel><TextBlock Text="{Binding TapTitle}" FontWeight="SemiBold"/><TextBlock Text="{Binding TapDescription}" Foreground="{DynamicResource SubtleTextBrush}"/></StackPanel><StackPanel Grid.Column="1"><TextBlock Text="{Binding HoldTitle}" FontWeight="SemiBold"/><TextBlock Text="Preview while held" Foreground="{DynamicResource SubtleTextBrush}"/></StackPanel></Grid>
        <CheckBox x:Name="StartupCheck" Content="Start FolderGlimpse when I sign in" Margin="0,24,0,0"/>
        <TextBlock x:Name="ErrorText" Foreground="#D13438" Margin="0,10,0,0" TextWrapping="Wrap"/>
        <Button Content="Get Started" Margin="0,20,0,0" Height="38" Style="{StaticResource PrimaryButtonStyle}" IsDefault="True" Click="GetStartedClicked"/>
      </StackPanel>
    </Border>
  </Grid>
</UserControl>
