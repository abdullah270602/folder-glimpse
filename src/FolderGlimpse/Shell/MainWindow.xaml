<Window x:Class="FolderGlimpse.Shell.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:branding="clr-namespace:FolderGlimpse.Branding"
        Title="FolderGlimpse" Width="860" Height="640" MinWidth="760" MinHeight="560"
        Icon="/FolderGlimpse;component/Assets/Branding/FolderGlimpse-App.ico"
        WindowStartupLocation="CenterScreen"
        Background="{DynamicResource WindowBrush}" UseLayoutRounding="True" SnapsToDevicePixels="True">
  <Window.Resources>
    <Style x:Key="NavItemStyle" TargetType="RadioButton">
      <Setter Property="Foreground" Value="{DynamicResource TextBrush}"/>
      <Setter Property="Background" Value="Transparent"/>
      <Setter Property="BorderThickness" Value="0"/>
      <Setter Property="Padding" Value="14,10"/>
      <Setter Property="Margin" Value="8,2"/>
      <Setter Property="HorizontalContentAlignment" Value="Left"/>
      <Setter Property="Cursor" Value="Hand"/>
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="RadioButton">
            <Border x:Name="Root" Background="{TemplateBinding Background}" CornerRadius="6" Padding="{TemplateBinding Padding}">
              <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="3"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                <Border x:Name="Indicator" Background="Transparent" CornerRadius="2"/>
                <ContentPresenter Grid.Column="1" Margin="11,0,0,0" VerticalAlignment="Center"/>
              </Grid>
            </Border>
            <ControlTemplate.Triggers>
              <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="Root" Property="Background" Value="{DynamicResource ControlHoverBrush}"/></Trigger>
              <Trigger Property="IsChecked" Value="True"><Setter TargetName="Root" Property="Background" Value="{DynamicResource SelectionBrush}"/><Setter TargetName="Indicator" Property="Background" Value="{DynamicResource SelectionBorderBrush}"/><Setter Property="FontWeight" Value="SemiBold"/></Trigger>
              <Trigger Property="IsKeyboardFocused" Value="True"><Setter TargetName="Root" Property="BorderBrush" Value="{DynamicResource AccentBrush}"/><Setter TargetName="Root" Property="BorderThickness" Value="1"/></Trigger>
            </ControlTemplate.Triggers>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>
  </Window.Resources>
  <Grid>
    <Grid x:Name="ShellGrid">
      <Grid.ColumnDefinitions><ColumnDefinition Width="188"/><ColumnDefinition Width="1"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
      <Border Background="{DynamicResource PanelBrush}">
        <Grid>
          <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
          <StackPanel Orientation="Horizontal" Margin="18,20,14,18">
            <branding:BrandMark Width="30" Height="30"/>
            <TextBlock Margin="10,0,0,0" VerticalAlignment="Center" FontSize="16" FontWeight="SemiBold"><Run Text="Folder"/><Run Text="Glimpse" Foreground="{DynamicResource BrandBlueBrush}"/></TextBlock>
          </StackPanel>
          <StackPanel Grid.Row="1">
            <RadioButton x:Name="HomeNav" GroupName="Navigation" Style="{StaticResource NavItemStyle}" Content="Home" Click="HomeClicked"/>
            <RadioButton x:Name="SettingsNav" GroupName="Navigation" Style="{StaticResource NavItemStyle}" Content="Settings" Click="SettingsClicked"/>
            <RadioButton x:Name="HowToNav" GroupName="Navigation" Style="{StaticResource NavItemStyle}" Content="How to Use" Click="HowToClicked"/>
            <RadioButton x:Name="AboutNav" GroupName="Navigation" Style="{StaticResource NavItemStyle}" Content="About" Click="AboutClicked"/>
          </StackPanel>
        </Grid>
      </Border>
      <Border Grid.Column="1" Background="{DynamicResource LineBrush}"/>
      <ContentControl x:Name="PageHost" Grid.Column="2"/>
    </Grid>
    <ContentControl x:Name="WelcomeHost" Visibility="Collapsed"/>
  </Grid>
</Window>
