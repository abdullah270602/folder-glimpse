<UserControl x:Class="FolderGlimpse.Shell.HomeView" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:branding="clr-namespace:FolderGlimpse.Branding">
  <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
    <StackPanel Margin="34,28,34,30">
      <StackPanel Orientation="Horizontal">
        <branding:BrandMark Width="48" Height="48" VerticalAlignment="Center"/>
        <TextBlock Margin="12,0,0,0" VerticalAlignment="Center" FontSize="28" FontWeight="SemiBold"><Run Text="Folder"/><Run Text="Glimpse" Foreground="{DynamicResource BrandBlueBrush}"/></TextBlock>
      </StackPanel>
      <TextBlock Text="Glance inside folders without opening them, and so much more." Margin="0,4,0,24" Foreground="{DynamicResource SubtleTextBrush}" FontSize="13"/>
      <Border Style="{StaticResource SettingsCardStyle}" Padding="18,15">
        <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
          <StackPanel><StackPanel Orientation="Horizontal"><Ellipse Width="9" Height="9" Fill="{DynamicResource BrandBlueBrush}" VerticalAlignment="Center"/><TextBlock Margin="9,0,0,0" Text="{Binding StatusText}" FontSize="15" FontWeight="SemiBold"/></StackPanel><TextBlock Text="{Binding StatusDetail}" Margin="18,5,0,0" Foreground="{DynamicResource SubtleTextBrush}"/></StackPanel>
          <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
            <TextBlock Text="Enabled" VerticalAlignment="Center" Margin="0,0,14,0"/>
            <CheckBox IsChecked="{Binding IsEnabled}" VerticalAlignment="Center" AutomationProperties.Name="FolderGlimpse enabled"/>
          </StackPanel>
        </Grid>
      </Border>
      <TextBlock Text="Quick Start" Style="{StaticResource SectionTitleStyle}" Margin="0,24,0,8"/>
      <Border Style="{StaticResource SettingsCardStyle}" Padding="18,16">
        <StackPanel><TextBlock Text="1   Open File Explorer"/><TextBlock Text="2   Select a folder" Margin="0,9,0,0"/><TextBlock Margin="0,9,0,0"><Run Text="3   Press "/><Run Text="{Binding ShortcutText, Mode=OneWay}" FontWeight="SemiBold" Foreground="{DynamicResource BrandBlueBrush}"/></TextBlock></StackPanel>
      </Border>
      <Grid Margin="0,10,0,0"><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="10"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
        <Border Style="{StaticResource SettingsCardStyle}" Padding="16,14"><StackPanel><TextBlock Text="{Binding TapTitle}" FontWeight="SemiBold"/><TextBlock Text="{Binding TapDescription}" Margin="0,5,0,0" Foreground="{DynamicResource SubtleTextBrush}"/></StackPanel></Border>
        <Border Grid.Column="2" Style="{StaticResource SettingsCardStyle}" Padding="16,14"><StackPanel><TextBlock Text="{Binding HoldTitle}" FontWeight="SemiBold"/><TextBlock Text="Preview while held" Margin="0,5,0,0" Foreground="{DynamicResource SubtleTextBrush}"/></StackPanel></Border>
      </Grid>
    </StackPanel>
  </ScrollViewer>
</UserControl>
