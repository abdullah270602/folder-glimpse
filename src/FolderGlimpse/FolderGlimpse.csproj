<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net8.0-windows</TargetFramework>
    <UseWPF>true</UseWPF>
    <UseWindowsForms>true</UseWindowsForms>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <ApplicationIcon>Assets\Branding\FolderGlimpse-App.ico</ApplicationIcon>
    <Platforms>x64</Platforms>
    <PlatformTarget>x64</PlatformTarget>
    <AssemblyName>FolderGlimpse</AssemblyName>
    <RootNamespace>FolderGlimpse</RootNamespace>
    <Product>FolderGlimpse</Product>
    <Title>FolderGlimpse</Title>
    <Description>Glance inside folders without opening them, and so much more.</Description>
    <PackageId>FolderGlimpse</PackageId>
    <Authors>Abdullah Naseem</Authors>
    <Company>Abdullah Naseem</Company>
    <RepositoryUrl>https://github.com/abdullah270602/folder-glimpse</RepositoryUrl>
    <RepositoryType>git</RepositoryType>
    <PackageLicenseExpression>MIT</PackageLicenseExpression>
    <Copyright>Copyright © 2026 Abdullah Naseem</Copyright>
    <NoWarn>$(NoWarn);WFAC010</NoWarn>
  </PropertyGroup>
  <ItemGroup>
    <ProjectReference Include="..\FolderGlimpse.Core\FolderGlimpse.Core.csproj" />
  </ItemGroup>
  <ItemGroup>
    <InternalsVisibleTo Include="FolderGlimpse.UiTests" />
  </ItemGroup>
  <ItemGroup>
    <Resource Include="Assets\Branding\FolderGlimpse-App.ico" />
    <Resource Include="Assets\Branding\FolderGlimpse-Tray.ico" />
    <Resource Include="Assets\Branding\FolderGlimpse-Mark-256.png" />
    <Resource Include="Assets\Branding\FolderGlimpse-Mark-512.png" />
  </ItemGroup>
</Project>
